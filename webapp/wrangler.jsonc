{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galv-an-dans",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "galvandans-db",
      "database_id": "977c5ce8-c1df-4ec2-b2c5-ef1613ed5e80"
    }
  ]
}
